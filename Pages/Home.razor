@page "/"
@using DiagonalDuel_Web.Logic
@using System.Globalization
@using DiagonalDuel_Web.Models
@using DiagonalDuel_Web.Pages
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IJSRuntime JS


<div class="game-header">
    <h1>Diagonal Duel</h1>
</div>

<div class="main-container">
    @if (isGameOver)
    {
        <h3>Game Over!</h3>
        <p>Your final score is: <strong>@score</strong></p>
        <button class="btn btn-primary" @onclick="StartNewGame">Play Again</button>

    }
    else
    {
        <p><strong>Round @round of @maxRounds</strong></p>
        <p>Guess the absolute difference between the matrix diagonals:</p>

        <!--Visual Guide
        <p class="text-center mb-1"><strong>Diagonal Guide</strong></p>-->
        <div class="diagonal-guide mx-auto mb-2">
            <div class="guide-row">
                <span class="primary-label text-primary fw-bold">↘ Primary Diagonal</span>
                <span class="secondary-label text-success fw-bold">Secondary Diagonal ↙</span>
            </div>
        </div>

        @*-----------Matrix table---------*@
        <table class="table table-bordered table-sm w-auto mx-auto text-center">
            <tbody>
                @for (int i = 0; i < matrix.Count; i++)
                {
                    <tr>
                        @for (int j = 0; j < matrix[i].Count; j++)
                        {
                            string cellClass = "";

                            if (i == j && i == (matrix.Count - j - 1)) // Both diagonals
                            {
                                cellClass = "bg-warning text-dark";
                            }
                            else if (i == j)
                            {
                                cellClass = "bg-primary text-white";
                            }
                            else if (i == (matrix.Count - j - 1))
                            {
                                cellClass = "bg-success text-white";
                            }

                            // Add flashing logic
                            string flashClass = "";
                            if (flashingPrimary.Contains((i, j)))
                            {
                                flashClass = "flash-primary";
                            }
                            else if (flashingSecondary.Contains((i, j)))
                            {
                                flashClass = "flash-secondary";
                            }

                            <td class="@($"{cellClass} {flashClass}")" style="width:40px; height: 40px; vertical-align: middle;">
                                @matrix[i][j]
                            </td>

                        }
                    </tr>
                }

            </tbody>
        </table>

        <input type="number" @bind="userGuess" class="form-control" placeholder="Enter your guess" />
        <button class="btn btn-success " @onclick="SubmitGuess">Submit</button>


        @if (!string.IsNullOrWhiteSpace(feedback))
        {
            <p class="feedback-message @feedbackClass">@feedback</p>
            <p>Current Score: <strong>@score</strong></p>
        }
    }
</div>


<!--Save Score Modal Component-->
<SaveScoreModal @ref="saveScoreModal" Score="@score" OnSave="SaveScoreToLeaderboard" />



@code
{
    private int round = 1;
    private int maxRounds = 5;
    private int score = 0;
    private int userGuess = 0;
    private string feedbackClass = "";

    private HashSet<(int, int)> flashingPrimary = new();
    private HashSet<(int, int)> flashingSecondary = new();



    private string feedback = "";
    private bool isGameOver = false;
    private List<List<int>> matrix = new();
    private Leaderboard? leaderboardRef;
    private SaveScoreModal? saveScoreModal;


    protected override void OnInitialized()
    {
        GenerateNewMatrix();

    }

    private async void GenerateNewMatrix()
    {
        int size = new Random().Next(2, 6);
        matrix = GameLogic.GenerateRandomMatrix(size);

        // Track diagonal cells
        flashingPrimary.Clear();
        flashingSecondary.Clear();

        for (int i = 0; i < size; i++)
        {
            flashingPrimary.Add((i, i)); // primary ↘
            flashingSecondary.Add((i, size - i - 1)); // secondary ↙
        }

        // Trigger flash effect
        StateHasChanged(); // re-render with flash classes
        await Task.Delay(700); // let animation play
        flashingPrimary.Clear();
        flashingSecondary.Clear();
        StateHasChanged(); // re-render without flash classes
    }


    private async Task SaveScoreToLeaderboard(string name)
    {

        var entry = new LeaderboardEntry
        {
            PlayerName = name,
            Score = score,
            DateAchieved = DateTime.Now
        };


        var leaderboard = await localStorage.GetItemAsync<List<LeaderboardEntry>>("leaderboard") ?? new
        List<LeaderboardEntry>();

        leaderboard.Add(entry);

        // Sort by score
        leaderboard = leaderboard.OrderByDescending(e => e.Score).Take(10).ToList();



        await localStorage.SetItemAsync("leaderboard", leaderboard);

        // This will refresh leaderboard
        if (leaderboardRef is not null)
        {
            await leaderboardRef.RefreshAsync();
        }

    }


    private async Task SubmitGuess()
    {
        int correctAnswer = GameLogic.DiagonalDifference(matrix);
        int difference = Math.Abs(userGuess - correctAnswer);

        if (difference == 0)
        {
            feedback = "Perfect guess!";
            score += 2;
            feedbackClass = "flash-correct";
        }
        else if (difference <= 2)
        {
            feedback = $"Almost! You were off by {difference}.";
            score += 1;
            feedbackClass = "flash-close";
        }
        else
        {
            feedback = "Too far off!";
            feedbackClass = "flash-wrong";
        }

        round++; // Go to the next round

        if (round > maxRounds)
        {
            isGameOver = true;
            await ShowSaveModal();
        }
        else
        {
            GenerateNewMatrix();
            userGuess = 0;
        }
    }

    private async Task ShowSaveModal()
    {

        if (saveScoreModal is not null)
        {
            await saveScoreModal.ShowAsync();
        }

    }


    private void StartNewGame()
    {
        round = 1;
        score = 0;
        feedback = "";
        isGameOver = false;
        GenerateNewMatrix();
    }
}
