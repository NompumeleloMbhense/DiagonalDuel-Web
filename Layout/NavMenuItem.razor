@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavManager

<li class="nav-item mb-3">
    <NavLink class="nav-link text-white" href="@Href" Match="Match">
        <i class="@GetIconClass() me-2"></i>
        <span class="fw-bold">@Text</span>
    </NavLink>
</li>

@code {
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string IconFilled { get; set; } = "";

    private bool IsActive =>
        Match == NavLinkMatch.All
            ? NavManager.Uri.Equals(NavManager.ToAbsoluteUri(Href).ToString(), StringComparison.OrdinalIgnoreCase)
            : NavManager.Uri.StartsWith(NavManager.ToAbsoluteUri(Href).ToString(), StringComparison.OrdinalIgnoreCase);

    private string GetIconClass() => IsActive ? IconFilled : Icon;
}
