@inherits LayoutComponentBase

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar (visible on md and up) -->
        <div class="col-md-3 col-lg-2 text-white sidebar d-none d-md-block p-3">
            <h5 class="mb-3">Diagonal Duel</h5>
            <ul class="nav flex-column">
                <NavMenuItem Href="/" Match="NavLinkMatch.All" Text="Home" Icon="bi bi-house-door"
                    IconFilled="bi bi-house-door-fill" />
                <NavMenuItem Href="/instructions" Text="Instructions" Icon="bi bi-file-earmark-text"
                    IconFilled="bi bi-file-earmark-text-fill" />
                <NavMenuItem Href="/leaderboard" Text="Leaderboard" Icon="bi bi-trophy"
                    IconFilled="bi bi-trophy-fill" />
            </ul>
        </div>

        <!-- Top navbar for small screens -->
        <nav class="navbar navbar-expand-lg navbar-dark d-md-none">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">Diagonal Duel</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <NavLink class="nav-link" activeClass="active fw-bold" href="/" Match="NavLinkMatch.All">
                                Home
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" activeClass="active fw-bold" href="/instructions">Instructions
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" activeClass="active fw-bold" href="/leaderboard">Leaderboard
                            </NavLink>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main content -->
        <main class="col px-4 pt-3 fade-in">
            @Body
        </main>
    </div>
</div>